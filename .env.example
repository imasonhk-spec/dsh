# =============================================================================
# DSH 全栈部署配置模板  —  复制为 .env 后填写
#   cp .env.example .env && vi .env
# 所有 {{VAR}} 模板在 deploy 时会被本文件的值替换。
# 不要在本文件里填写真实生产密钥后再提交；.env 已被 .gitignore 忽略。
# =============================================================================

# ---------- 主机 / 用户 ----------
# 运行 DSH 的 Linux 用户名（systemd 单元以该用户运行）
DSH_USER=lgsj
# 本机对内网暴露的 IP（用于 --trusted-host 与 nginx 绑定的 server_name）
DSH_HOST_IP=192.168.8.6
# harness 源码目录（即仓库内 harness/ 部署到目标机的绝对路径）
HARNESS_DIR=/home/lgsj/deepseek-harness.dsh-v0.1.5-rc.1
# DSH 数据根目录（~/.dsh）
DSH_HOME=/home/lgsj/.dsh
TZ=Asia/Shanghai

# ---------- 端口 ----------
DSH_WEB_PORT=3080          # dsh-web 主端口（loopback）
DSH_MU_PORT=3090           # 多用户网关端口（由 dsh-multi-user 插件开启）
DSH_NGINX_HTTP_PORT=3081   # nginx 明文（3082 跳转）
DSH_NGINX_HTTPS_PORT=3082  # nginx TLS（对外入口）
RAG_SIDECAR_PORT=17321     # 宿主 RAG sidecar 端口

# ---------- 访问令牌 ----------
# dsh-web 启动令牌；可用 `openssl rand -hex 24` 生成。nginx 会用它做自动登录跳转。
DSH_WEB_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSsl_RAND_HEX_24

# ---------- 知识库 RAG sidecar 的推理/向量模型 ----------
#  intake（入库抽取）与问答走同一个 LLM；base_url 需为 OpenAI 兼容端点
RAG_LLM_BASE_URL=http://127.0.0.1:11434/v1
RAG_LLM_MODEL=qwen3.5:32b
RAG_LLM_API_KEY=ollama
# 视觉/版面解析（mineru 用）
RAG_VISION_BASE_URL=http://127.0.0.1:11434/v1
RAG_VISION_MODEL=qwen3.5-vl:32b
# 向量化与重排用的本地 GGUF 模型路径（需自行放置 bge-m3 / bge-reranker-v2-m3 的 gguf）
RAG_EMBEDDING_MODEL_PATH=/home/lgsj/.dsh/raganything/models/bge-m3-q8_0.gguf
RAG_RERANK_MODEL_PATH=/home/lgsj/.dsh/raganything/models/bge-reranker-v2-m3-q8_0.gguf

# ---------- DSH 全局 LLM provider（面板「设置→模型」的默认 provider） ----------
LLM_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
LLM_PROVIDER_API_KEY=ollama

# ---------- TLS 证书（nginx 用） ----------
SSL_CERT_PATH=/etc/ssl/dsh/server.crt
SSL_KEY_PATH=/etc/ssl/dsh/server.key

# ---------- 依赖安装代理（目标盒无 DNS / 需走隧道时填写） ----------
# 例如 8.6 走本地反向隧道：http://127.0.0.1:11808
# 留空 = 直连公网
DEPLOY_HTTP_PROXY=
DEPLOY_HTTPS_PROXY=

# ---------- RAG venv 是否安装 CUDA（N 卡盒子=true，其余=false） ----------
RAG_CUDA=false

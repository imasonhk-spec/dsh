# /etc/systemd/system/dsh-web.service.d/10-proxy.conf
# 仅当目标盒无公网 DNS（依赖反向隧道代理）时由 deploy 安装。
#
# 根因：pnpm 的 bootstrap 阶段（早于 ~/.npmrc 加载）要连 registry.npmjs.org 解析
# 包管理器版本。整机 DNS 不可用时该请求失败后走 JS 层退避，表现为启动卡 70s+。
# 让 pnpm 走已存在的 HTTP 代理（由远端解析域名，本地无需 DNS）。实测 72s -> 1s。
# NO_PROXY 必须覆盖本机与内网，否则 17321/3080/3090 的本地互访会被塞进代理。
[Service]
Environment="HTTP_PROXY={{DEPLOY_HTTP_PROXY}}"
Environment="HTTPS_PROXY={{DEPLOY_HTTPS_PROXY}}"
Environment="http_proxy={{DEPLOY_HTTP_PROXY}}"
Environment="https_proxy={{DEPLOY_HTTPS_PROXY}}"
Environment="NO_PROXY=localhost,127.0.0.1,::1,0.0.0.0,{{DSH_HOST_IP}}"
Environment="no_proxy=localhost,127.0.0.1,::1,0.0.0.0,{{DSH_HOST_IP}}"

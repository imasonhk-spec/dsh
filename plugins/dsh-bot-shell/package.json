{
  "name": "dsh-bot-shell",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "meta": {
    "title": "Bot对话",
    "description": "DS Bot 悬浮外壳：把独立的 Bot 实例（DS Bot 原生界面 + 4 个领域插件面板）同源挂到 /bot，并在主界面提供悬浮窗/融入态双向切换与归档入口。"
  }
}
